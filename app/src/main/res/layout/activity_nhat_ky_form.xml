<?xml version="1.0" encoding="utf-8"?>
<!-- activity_nhat_ky_form.xml -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorPrimary"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card 1: Thông tin chung -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/thong_tin_chung"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/textPrimary"
                        android:layout_marginBottom="12dp" />

                    <!-- Loại nhật ký (RadioGroup) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/loai_nhat_ky"
                        android:textSize="12sp"
                        android:textColor="@color/textSecondary"
                        android:layout_marginBottom="4dp" />

                    <RadioGroup
                        android:id="@+id/radioGroupLoai"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">

                        <RadioButton android:id="@+id/radioTuoiPhan"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/loai_tuoi_phan" android:textSize="14sp" />
                        <RadioButton android:id="@+id/radioPhunThuoc"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/loai_phun_thuoc" android:textSize="14sp" />
                        <RadioButton android:id="@+id/radioTinhHinh"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/loai_tinh_hinh" android:textSize="14sp"
                            android:checked="true" />
                        <RadioButton android:id="@+id/radioThuHoach"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/loai_thu_hoach" android:textSize="14sp" />
                    </RadioGroup>

                    <!-- Ngày thực hiện -->
                    <LinearLayout
                        android:id="@+id/layoutNgayThucHien"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_spinner_outline"
                        android:paddingHorizontal="12dp"
                        android:layout_marginBottom="12dp"
                        android:clickable="true" android:focusable="true">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_today"
                            android:tint="@color/colorPrimary" android:contentDescription="@null" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="8dp"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/ngay_thuc_hien" android:textSize="11sp"
                                android:textColor="@color/textSecondary" />
                            <TextView android:id="@+id/tvNgayThucHien" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="14sp"
                                android:textColor="@color/textPrimary" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Người thực hiện -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/nguoi_thuc_hien"
                        android:layout_marginBottom="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNguoiThucHien"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="textPersonName" android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Ghi chú chung -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/ghi_chu">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etGhiChu"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="textMultiLine" android:minLines="2"
                            android:gravity="top" android:imeOptions="actionDone" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Section Tưới phân (hiện/ẩn theo loại) -->
            <LinearLayout
                android:id="@+id/sectionTuoiPhan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="12dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="@string/chi_tiet_phan"
                                android:textSize="14sp" android:textStyle="bold"
                                android:textColor="@color/textPrimary" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnThemTuoiPhan"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content" android:layout_height="36dp"
                                android:text="@string/them_dong"
                                app:cornerRadius="8dp" app:icon="@android:drawable/ic_input_add" />
                        </LinearLayout>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvTuoiPhan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Card 3: Section Phun thuốc -->
            <LinearLayout
                android:id="@+id/sectionPhunThuoc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="12dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="@string/chi_tiet_thuoc"
                                android:textSize="14sp" android:textStyle="bold"
                                android:textColor="@color/textPrimary" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnThemPhunThuoc"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content" android:layout_height="36dp"
                                android:text="@string/them_dong"
                                app:cornerRadius="8dp" app:icon="@android:drawable/ic_input_add" />
                        </LinearLayout>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvPhunThuoc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Save -->
            <ProgressBar android:id="@+id/progressBar" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center"
                android:visibility="gone" android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:text="@string/luu" android:textSize="16sp" android:textStyle="bold"
                app:cornerRadius="10dp" android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
